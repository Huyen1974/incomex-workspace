+def coverage_matrix(cat, res, dr, inv, prev_inv, now):
+    """Ma trận bao phủ từng họ G1–G9 (máy đọc được, DataHub/OpenLineage-kiểu: nguồn·phiên bản·khớp·thay đổi·khả năng thu thay đổi·chủ)."""
+    fams = dict(FAMILY_DEFAULT)
+    for g, v in (cat.get("families") or {}).items():
+        fams[g] = dict(fams.get(g) or {}, **v)
+    out = {}
+    pg_ = (dr or {}).get("per_gate") or {}
+    for g in sorted(GATE_PREFIX):
+        f = fams.get(g) or {}
+        cells = [c for c in res.values() if c.get("gate") == g]
+        du = [c["key"] for c in cells if c.get("status") == DU]
+        cur = (inv or {}).get(g) or {"ok": False, "errors": ["không chụp"], "kinds": {}}
+        diff = inventory_diff(((prev_inv or {}).get("families") or {}).get(g), cur) if cur.get("ok") else None
+        gate = pg_.get(g) or {}
+        native = {k: len(v) for k, v in (cur.get("kinds") or {}).items()}
+        if not cur.get("ok") or not gate.get("read", False):
+            st = "READER_FAILED"
+        elif gate.get("unadmitted") or gate.get("vanished"):
+            st = "PENDING_SOURCE_CELL"
+        elif cells and len(du) == len(cells):
+            st = "CERTIFIED_AT_T"
+        elif diff and diff["total_changes"]:
+            st = "SOURCE_CHANGED"
+        else:
+            st = "PARTIAL_UNMODELED"
+        out[g] = {"gate": g, "family": f.get("family"), "enumerator": f.get("enumerator"), "owner": f.get("owner") or OWNER,
+                  "alert_recipient": f.get("alert_recipient") or "Telegram Owner qua đèn Kuma #24 (Graph Certificate) · biên nhận state/refresh/cert/incidents.jsonl",
+                  "native_counts": native, "inventory_sha256": hashlib.sha256(jkey(cur.get("kinds") or {}).encode()).hexdigest() if cur.get("ok") else None,
+                  "source_version": cur.get("version"), "read_at": cur.get("read_at"), "consistency": cur.get("consistency"),
+                  "reader_errors": cur.get("errors"),
+                  "parents": {"count": gate.get("parents"), "unadmitted": gate.get("unadmitted") or [], "vanished": gate.get("vanished") or []},
+                  "cells": {"total": len(cells), "du": len(du), "du_cells": du,
+                            "graph_objects": sum(((c.get("graph") or {}).get("objects_count") or 0) for c in cells),
+                            "graph_edges": sum(((c.get("graph") or {}).get("edges_count") or 0) for c in cells)},
+                  "change_since_last_good": diff, "supported_ingestion": bool(f.get("supported_ingestion", any((c.get("graph") is not None) for c in cells))),
+                  "durable_change_capture": f.get("durable_change_capture") or {"available": False, "why": "chỉ chụp mỗi đêm (NIGHTLY_SNAPSHOT_DIFF)"},
+                  "ephemeral_change_observable": False, "blind_spot": "EPHEMERAL_CHANGE_NOT_OBSERVABLE: đối tượng sinh rồi mất giữa hai lượt chụp, "
+                                                                     "thay đổi dữ liệu dòng/bản ghi không có CDC/audit bền",
+                  "out_of_scope_unknown": f.get("out_of_scope_unknown") or [], "status": st,
+                  "certificate": "ĐỦ" if st == "CERTIFIED_AT_T" else "MỘT PHẦN", "next_action": f.get("next_action") or
+                  "C1-D: nhận/đối chiếu theo lô có bảo vệ cho lớp chưa nạp; giữ MỘT PHẦN tới khi có ô ĐỦ"}
+    return out
