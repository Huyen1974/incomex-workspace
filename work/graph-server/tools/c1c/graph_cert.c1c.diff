+def refresh_lock_held(lock=REFRESH_LOCK, locks="/proc/locks"):
+    """True khi có khoá FLOCK trên inode tệp khoá graph-refresh (lượt làm mới/cấp giấy đang chạy). Không tự lấy khoá (tránh làm lượt timer
+    SKIP). Không đọc được /proc/locks ⇒ None (không chứng minh được)."""
+    try:
+        st = os.stat(lock)
+    except OSError:
+        return False
+    tag = "%02x:%02x:%d" % (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
+    try:
+        with open(locks) as f:
+            for ln in f:
+                p = ln.split()
+                if "FLOCK" in p and tag in p:
+                    return True
+    except OSError:
+        return None
+    return False
+
