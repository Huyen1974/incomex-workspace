+    """Ảnh kiểm kê độc lập từng họ (cha + con + quan hệ, vân tay từng mục) từ chính bộ đọc gốc của lượt này ⇒ {G: fam}.
+    fam = {ok, errors, kinds: {kind: {id: fp}}, version: {...}, read_at, consistency}"""
+    t = now_iso()
+    inv = {}
+
+    def fam(g, kinds, errors=None, version=None, consistency="SINGLE_READ"):
+        inv[g] = {"ok": not errors, "errors": errors or [], "kinds": kinds if not errors else {}, "version": version or {}, "read_at": t,
+                  "consistency": consistency}
+    par = (dr or {}).get("parents") or {}
+    p = S.get("pg")
+    if p.get("_error"):
+        fam("G1", {}, ["pg " + p["_error"]])
+    else:
+        kinds, errs, ver = {"database": {x: "" for x in par.get("G1") or []}}, [], {}
+        for db, d in sorted(p.items()):
+            if not isinstance(d, dict) or "classes" not in d and "error" not in d:
+                continue
+            if d.get("error"):
+                errs.append("pg:%s %s" % (db, d["error"]))
+                continue
+            ver[db] = {"pg_snapshot": (d.get("reader") or {}).get("pg_snapshot"), "snapshot_utc": (d.get("reader") or {}).get("snapshot_utc")}
+            for cls, c in sorted((d.get("classes") or {}).items()):
+                if cls in ("databases", "cdc_caps", "wal_lsn", "kb", "l1_fk", "view_dep_kind", "dot_tools"):
+                    continue
+                if not c.get("ok"):
+                    errs.append("pg:%s.%s %s" % (db, cls, c.get("error")))
+                    continue
+                key = (lambda r: "%s.%s.%s" % (r[0], r[1], r[2])) if cls == "trigger" else \
+                      (lambda r: "%s|%s" % (r[0], r[1])) if cls in ("view_dep", "directus_relation") else \
+                      (lambda r: r[0] + "." + r[1]) if cls == "fk" else (lambda r: r[0])
+                kinds["%s.%s" % (db, cls)] = _idmap(c["rows"], key)
+        caps = ((p.get("postgres") or {}).get("classes") or {}).get("cdc_caps") or {}
+        lsn = ((p.get("postgres") or {}).get("classes") or {}).get("wal_lsn") or {}
+        ver["cdc_caps"] = dict(caps.get("rows") or []) if caps.get("ok") else {"error": caps.get("error") or "không đọc"}
+        ver["wal_lsn"] = (lsn.get("rows") or [[None]])[0][0] if lsn.get("ok") else None
+        fam("G1", kinds, errs, ver, "PG_REPEATABLE_READ_READ_ONLY")
+    d = S.get("docker")
+    if d.get("error") or d.get("_error"):
+        fam("G2", {}, ["docker " + str(d.get("error") or d.get("_error"))])
+    else:
+        fam("G2", {"container": {c[0]: str(c[1])[:23] for c in d["containers"]}, "image": {x: "" for x in d["images"]},
+                   "container_edge": {_h(e): "" for e in d["edges"]}}, None, {"containers": len(d["containers"]), "images": len(d["images"])},
+            "BEFORE_AFTER_EQUAL" if d["names_before"] == d["names_after"] else "DRIFT")
+    si = S.get("systemd_inv")
+    sd = S.get("systemd")
+    if si.get("error") or si.get("_error") or sd.get("error") or sd.get("_error"):
+        fam("G3", {}, ["systemd " + str(si.get("error") or si.get("_error") or sd.get("error") or sd.get("_error"))])
+    else:
+        fam("G3", {"unit": dict(si["units"]), "dropin": dict(si["dropins"]), "unit_edge": {_h(e): "" for e in sd["edges"]}}, None,
+            {"units": len(si["units"]), "dropins": len(si["dropins"])}, "BEFORE_AFTER_EQUAL" if si.get("stable") else "DRIFT")
+    c = S.get("cron")
+    cf = S.get("cron_files")
+    if c.get("_error") or c.get("errors") or cf.get("_error") or cf.get("errors"):
+        fam("G4", {}, ["cron " + str(c.get("_error") or c.get("errors") or cf.get("_error") or cf.get("errors"))])
+    else:
+        fam("G4", {"entry": {e[0]: "" for e in c["entries"]}, "file": dict(cf["files"])}, None, {"entries": len(c["entries"])})
+    n = S.get("nginx")
+    li = S.get("listeners")
+    if n.get("error") or n.get("_error") or li.get("error") or li.get("_error"):
+        fam("G5", {}, ["nginx " + str(n.get("error") or n.get("_error") or li.get("error") or li.get("_error"))])
+    else:
+        fam("G5", {"server": {x[0]: "" for x in n["servers"]}, "route": {e[0] + "->" + e[2]: "" for e in n["edges"]},
+                   "listen": {x: "" for x in li["listen"]}}, None, {"conf_sha256": (n.get("conf_sha256") or "")[:16]})
+    o = S.get("opt")
+    cfi = S.get("code_files")
+    if o.get("error") or o.get("_error") or o.get("ledger") is None or cfi.get("error") or cfi.get("_error"):
+        fam("G6", {}, ["opt " + str(o.get("error") or o.get("_error") or cfi.get("error") or cfi.get("_error") or "code-ledger")])
+    else:
+        fam("G6", {"entry": {e[0]: e[1] for e in o["entries"]}, "ledger_row": {r[0]: r[1] for r in o["ledger"]}, "code_file": dict(cfi["files"])},
+            None, {"ledger_rows": len(o["ledger"]), "not_hashable": cfi.get("not_hashable"), "size_capped": cfi.get("size_capped")})
+    q = S.get("qdrant")
+    if q.get("error") or q.get("_error"):
+        fam("G7", {}, ["qdrant " + str(q.get("error") or q.get("_error"))])
+    else:
+        kinds = {"collection": {k: _h(v) for k, v in (q.get("collections") or {}).items()}, "alias": {a[0]: a[1] for a in q.get("aliases") or []}}
+        qi = S.cache.get("qdrant_ids") or {}
+        ver = {"points_count": q.get("counts") or {}}
+        if qi and not qi.get("error") and qi.get("scroll_complete") and qi.get("count_before") == qi.get("count_after"):
+            kinds["document_id:production_documents"] = {"h:" + hashlib.sha256(x.encode()).hexdigest()[:16]: "" for x in qi.get("doc_ids") or []}
+            ver["points_without_document_id"] = qi.get("points_without_document_id")
+            fam("G7", kinds, None, ver)
+        else:   # không đọc trọn document_id ⇒ không so (tránh «xoá giả»)
+            fam("G7", {}, ["qdrant scroll document_id không trọn/không chạy"])
+    lb = S.get("lark_bases")
+    lk = S.cache.get("lark") or {}
+    b8 = S.cache.get("b88") or {}
+    if lb.get("error") or lb.get("_error") or lk.get("_error") or not lk or not b8 or b8.get("_error"):
+        fam("G8", {}, ["lark " + str(lb.get("error") or lb.get("_error") or lk.get("_error") or b8.get("_error") or "bộ đọc Lark/b88 không chạy lượt này")])
+    else:
+        kinds = {"base": {x: "" for x in lb["bases"]}, "table": {}, "link_field": {}}
+        errs = []
+        for b, e in sorted(lk.items()):
+            if not isinstance(e, dict):
+                continue
+            if e.get("error") or e.get("field_errors"):
+                errs.append("lark:%s %s" % (b, e.get("error") or "field_errors"))
+                continue
+            kinds["table"].update({"%s/%s" % (b, x): "" for x in e.get("tables") or []})
+            kinds["link_field"].update({"%s/%s.%s" % (b, l[0], l[1]): str(l[2]) for l in e.get("links") or []})
+        kinds["b88_record"] = _idmap(b8.get("objects"), key=lambda r: r[1], private=True)
+        kinds["b88_link"] = {_h(e): "" for e in b8.get("edges") or []}
+        fam("G8", kinds, errs, {"b88_freeze_sha256": (b8.get("freeze_sha256") or "")[:16] or None})
+    gi = S.get("git")
+    gr = S.get("git_repos")
+    if gi.get("error") or gi.get("_error") or gr.get("error") or gr.get("_error"):
+        fam("G9", {}, ["git " + str(gi.get("error") or gi.get("_error") or gr.get("error") or gr.get("_error"))])
+    else:
+        fam("G9", {"work_dir": {x: "" for x in gi["dirs"]}, "repo": dict(gr["repos"])}, None,
+            {"workspace_head": (gi.get("head") or "")[:12], "repos_without_head": gr.get("errors") or []}, "GIT_COMMIT")
+    return inv
