+def graph_fence(doc, live=None, lock_state="auto"):
+    """K1 lúc đọc: so mốc phiên bản Graph trong giấy với Graph sống ⇒ {status: MATCH | GRAPH_CHANGED_SINCE_CERT | GRAPH_REVISION_UNVERIFIED |
+    GRAPH_MUTATION_IN_PROGRESS, ...}. Không dựa tệp ghim (pins/invariants); giấy không mốc hoặc mốc không ổn định ⇒ UNVERIFIED."""
+    ce = (doc or {}).get("graph_epoch") if isinstance(doc, dict) else None
+    f = {"fence": "neo4j-http-bookmark+container-start", "checked_at": now_iso(),
+         "cert_epoch": {k: (ce or {}).get(k) for k in ("container", "started_at", "restart_count")} if ce else None,
+         "cert_bookmark_sha16": ((ce or {}).get("bookmark_sha256") or "")[:16] or None}
+    if not epoch_key(ce) or (ce or {}).get("stable_during_run") is not True:
+        return dict(f, status="GRAPH_REVISION_UNVERIFIED", why="giấy không có mốc phiên bản Graph ổn định (cấp trước C1-C hoặc đổi giữa lượt)")
+    lk = refresh_lock_held() if lock_state == "auto" else lock_state
+    if lk is None:
+        return dict(f, status="GRAPH_REVISION_UNVERIFIED", why="không đọc được /proc/locks")
+    if lk:
+        return dict(f, status="GRAPH_MUTATION_IN_PROGRESS", why="khoá graph-refresh đang giữ (lượt làm mới/cấp giấy đang chạy)")
+    le = (live or live_graph_epoch)()
+    f["live_bookmark_sha16"] = ((le or {}).get("bookmark_sha256") or "")[:16] or None
+    f["live_epoch"] = {k: (le or {}).get(k) for k in ("container", "started_at", "restart_count")}
+    if not epoch_key(le):
+        return dict(f, status="GRAPH_REVISION_UNVERIFIED", why="không đọc được phiên bản Graph sống: %s" % (le or {}).get("error"))
+    if epoch_key(le) != epoch_key(ce):
+        diff = [n for n, a, b in zip(("bookmark", "container", "started_at", "restart_count"), epoch_key(le), epoch_key(ce)) if a != b]
+        return dict(f, status="GRAPH_CHANGED_SINCE_CERT", why="Graph đổi so với lúc cấp giấy: " + ",".join(diff))
+    return dict(f, status="MATCH", why=None)


