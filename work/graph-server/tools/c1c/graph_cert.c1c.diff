+def inventory_diff(prev, cur):
+    """So hai ảnh kiểm kê một họ ⇒ {added, removed, modified: {kind: n}, samples, first}. Tập mã (không phải số lượng) ⇒ đổi chỗ cùng số vẫn bắt."""
+    if not prev or not prev.get("kinds"):
+        return {"first": True, "added": {}, "removed": {}, "modified": {}, "total_changes": 0, "samples": []}
+    add, rem, mod, smp = {}, {}, {}, []
+    for k in sorted(set(prev["kinds"]) | set(cur["kinds"])):
+        a, b = prev["kinds"].get(k) or {}, cur["kinds"].get(k) or {}
+        na, nr = sorted(set(b) - set(a)), sorted(set(a) - set(b))
+        nm = sorted(x for x in set(a) & set(b) if a[x] != b[x])
+        if na:
+            add[k] = len(na)
+        if nr:
+            rem[k] = len(nr)
+        if nm:
+            mod[k] = len(nm)
+        for tag, xs in (("+", na), ("-", nr), ("~", nm)):
+            smp += ["%s%s %s" % (tag, k, x if not x.startswith("h:") else "(mã băm riêng tư)") for x in xs[:3]]
+    tot = sum(add.values()) + sum(rem.values()) + sum(mod.values())
+    return {"first": False, "added": add, "removed": rem, "modified": mod, "total_changes": tot, "samples": smp[:12]}
+
