+def graph_epoch(g, pw):
+    """Phiên bản Graph SỐNG = sha256(bookmark HTTP sau MỘT lần đọc trên db neo4j) + Id/StartedAt/RestartCount container. Bookmark là chuỗi
+    mờ (chỉ so bằng nhau, không giải mã, không lưu thô): đổi ở mọi commit, đứng yên khi chỉ đọc (thử Neo4j tạm 23/10)."""
+    out = {"fence": "neo4j-http-bookmark+container-start", "read_at": now_iso()}
+    try:
+        d = g.http_cypher([("RETURN 1 AS x", {})], pw, timeout=20)
+        bm = (d.get("lastBookmarks") or [None])[0]
+        if d.get("errors") or not isinstance(bm, str) or not bm:
+            return dict(out, error="BOOKMARK_UNAVAILABLE")
+        out["bookmark_sha256"] = hashlib.sha256(bm.encode()).hexdigest()
+    except BaseException as e:  # noqa: BLE001 — kể cả SystemExit của password()
+        return dict(out, error="GRAPH_READ_FAIL %s" % type(e).__name__)
+    rc, o, _ = sh(["docker", "inspect", "--format", "{{.Id}}|{{.State.StartedAt}}|{{.State.Running}}|{{.RestartCount}}", GRAPH_CTR], timeout=20)
+    p = o.strip().split("|")
+    if rc != 0 or len(p) != 4 or p[2] != "true":
+        return dict(out, error="CONTAINER_STATE_UNAVAILABLE")
+    out.update(container=p[0][:12], started_at=p[1], restart_count=p[3])
+    return out
+
+
+def epoch_key(e):
+    if not isinstance(e, dict) or e.get("error") or not e.get("bookmark_sha256"):
+        return None
+    return [e.get("bookmark_sha256"), e.get("container"), e.get("started_at"), e.get("restart_count")]
+
+
+_LIVE = {}
+
+
+def live_graph_epoch():
+    """Đọc phiên bản Graph sống cho nhãn (mật khẩu GSM nạp MỘT lần/tiến trình, chỉ trong bộ nhớ)."""
+    try:
+        if not _LIVE.get("pw"):
+            sys.path.insert(0, RB)
+            import r7_g1lib
+            g = r7_g1lib.load(G1)
+            _LIVE["g"], _LIVE["pw"] = g, g.password()
+        return graph_epoch(_LIVE["g"], _LIVE["pw"])
+    except BaseException as e:  # noqa: BLE001
+        _LIVE.clear()
+        return {"error": "LIVE_EPOCH_FAIL %s" % type(e).__name__}
