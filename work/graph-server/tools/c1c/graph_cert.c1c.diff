+def code_files_read(max_bytes=20 * 1024 * 1024):
+    """G6 vân tay tệp mã trong sổ mã (code-ledger, chặn trên 20 MiB/tệp) — mã mới triển khai dưới thư mục/mount cũ ⇒ SỬA."""
