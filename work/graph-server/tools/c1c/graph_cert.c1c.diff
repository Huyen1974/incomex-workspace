+def systemd_inv_read():
+    """G3 mọi loại unit trong /etc/systemd/system (tệp thường, không symlink) + drop-in *.d/*.conf, vân tay = sha256 nội dung."""
+    def scan():
+        units, drop = {}, {}
+        for f in sorted(os.listdir(SYSTEMD_DIR)):
+            p = os.path.join(SYSTEMD_DIR, f)
+            if f.endswith(UNIT_SUFFIX) and os.path.isfile(p) and not os.path.islink(p):
+                units[f] = (_file_sha(p) or "?")[:16]
+            elif f.endswith(".d") and os.path.isdir(p) and not os.path.islink(p):
+                for x in sorted(os.listdir(p)):
+                    q = os.path.join(p, x)
+                    if x.endswith(".conf") and os.path.isfile(q):
+                        drop[f + "/" + x] = (_file_sha(q) or "?")[:16]
+        return units, drop
+    try:
+        u1, d1 = scan()
+        u2, d2 = scan()
+    except OSError as e:
+        return {"error": type(e).__name__}
+    return {"units": u1, "dropins": d1, "stable": (u1, d1) == (u2, d2)}
+
+
+def cron_files_read():
+    """G4 vân tay nội dung từng tệp cron (spool, cron.d, crontab, run-parts) — sửa một dòng trong tệp cũ ⇒ SỬA."""
+    files = []
+    for b in ("/var/spool/cron/crontabs", "/etc/cron.d", "/etc/cron.hourly", "/etc/cron.daily", "/etc/cron.weekly", "/etc/cron.monthly"):
+        if os.path.isdir(b):
+            files += [os.path.join(b, x) for x in sorted(os.listdir(b)) if not x.startswith(".")]
+    files.append("/etc/crontab")
+    out, err = {}, []
+    for p in files:
+        h = _file_sha(p)
+        if h is None:
+            err.append(p)
