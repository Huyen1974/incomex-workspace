+def _sd_show(units, props):
+    """systemctl show nhiều unit một lần ⇒ {Id: {prop: [giá trị…]}} (thuộc tính lặp như Listen= gom thành danh sách)."""
+    if not units:
+        return {}
+    rc, o, _ = sh(["systemctl", "show", "--no-pager", "-p", ",".join(["Id"] + props)] + sorted(units), timeout=60)
+    if rc != 0:
+        raise RuntimeError("systemctl show rc=%s" % rc)
+    out, cur = {}, {}
+    for ln in o.splitlines() + [""]:
+        if not ln.strip():
+            if cur.get("Id"):
+                out[cur["Id"][0]] = cur
+            cur = {}
+            continue
+        k, _, v = ln.partition("=")
+        cur.setdefault(k, []).append(v)
+    return out
+
+
+def net_owner_read():
+    """G5 cổng nghe TCP ⇒ chủ: ss -ltnp (pid) + /proc/<pid>/cgroup (unit) · docker-proxy -host-ip/-host-port/-container-ip ⇒ container theo IP
+    mạng · pid 1 giữ fd ⇒ unit .socket có Listen= trùng. Cổng không có chủ chắc chắn ⇒ ambiguous (không đoán)."""
+    rc, o, _ = sh(["ss", "-H", "-ltnp"], timeout=30)
+    if rc != 0:
+        return {"error": "ss rc=%s" % rc}
+    lst = {}
+    for ln in o.splitlines():
+        p = ln.split()
+        if len(p) < 4:
+            continue
+        lst.setdefault(p[3], set()).update(int(x) for x in re.findall(r"pid=(\d+)", ln))
+    rc, o2, _ = sh(["docker", "ps", "-q", "--no-trunc"], timeout=60)
+    ipmap = {}
+    if rc == 0 and o2.split():
+        rc, o3, _ = sh(["docker", "inspect", "-f", "{{.Name}}|{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}"] + o2.split(), timeout=60)
+        for ln in o3.splitlines():
+            n, _, ips = ln.partition("|")
+            for ip in ips.split():
+                ipmap[ip] = n.lstrip("/")
+    rc, o4, _ = sh(["systemctl", "list-units", "--type=socket", "--all", "--plain", "--no-legend", "--no-pager"], timeout=60)
+    socks = [ln.split()[0] for ln in o4.splitlines() if ln.split() and ln.split()[0].endswith(".socket")]
+    listen_of = {}
+    for u, d in _sd_show(socks, ["Listen"]).items():
+        for v in d.get("Listen") or []:
+            listen_of.setdefault(v.split(" (")[0], []).append(u)
+    edges, amb, units, ctrs = [], [], set(), set()
+    for addr, pids in sorted(lst.items()):
+        got = 0
+        for pid in sorted(pids):
+            if pid == 1:
+                for u in listen_of.get(addr, []):
+                    edges.append([u, "LISTENS_ON", addr])
+                    units.add(u)
+                    got += 1
+                continue
+            try:
+                comm = open("/proc/%d/comm" % pid).read().strip()
+                cg = open("/proc/%d/cgroup" % pid).read().strip().splitlines()[0].split(":", 2)[-1]
+                cmd = open("/proc/%d/cmdline" % pid, "rb").read().split(b"\0")
+            except OSError:
+                continue
+            if comm == "docker-proxy":
+                a = [x.decode(errors="replace") for x in cmd]
+                v = {a[i]: a[i + 1] for i in range(len(a) - 1) if a[i].startswith("-")}
+                c = ipmap.get(v.get("-container-ip"))
+                hip = v.get("-host-ip")
+                want = ("[%s]:%s" % (hip, v.get("-host-port"))) if hip and ":" in hip else "%s:%s" % (hip, v.get("-host-port"))
+                if c and want == addr:
+                    edges.append([addr, "PUBLISHED_BY", c])
+                    ctrs.add(c)
+                    got += 1
+                continue
+            u = cg.rstrip("/").split("/")[-1]
+            if cg.startswith("/system.slice/") and u.endswith(".service"):
+                edges.append([addr, "BOUND_BY_PROCESS_OF", u])
+                units.add(u)
+                got += 1
+        if not got:
+            amb.append(addr)
+    uniq = {jkey(e): e for e in edges}
+    return {"listen": sorted(lst), "edges": list(uniq.values()), "ambiguous": amb, "units": sorted(units), "containers": sorted(ctrs)}
+
+
+def units_declared_read(declared, extra):
+    """G3 unit khai báo (systemctl show — ánh xạ systemd TỰ khai, không suy từ lúc chạy): .socket/.path ⇒ TRIGGERS · .mount ⇒ dịch vụ khai
+    RequiredBy ⇒ REQUIRES_MOUNT. Nút = unit khai báo ∪ đích ∪ unit sở hữu cổng nghe (extra)."""
+    d = _sd_show(declared, ["Triggers", "Listen", "What", "Where", "RequiredBy", "FragmentPath", "LoadState"])
+    edges, names = [], set(declared) | set(extra)
+    for u in declared:
+        x = d.get(u)
+        if not x or (x.get("LoadState") or [""])[0] != "loaded":
+            return {"error": "unit khai báo không nạp: %s" % u}
+        for t in " ".join(x.get("Triggers") or []).split():
+            edges.append([u, "TRIGGERS", t])
+            names.add(t)
+        if u.endswith(".mount"):
+            for s in " ".join(x.get("RequiredBy") or []).split():
+                edges.append([s, "REQUIRES_MOUNT", u])
+                names.add(s)
+    info = _sd_show(sorted(names), ["FragmentPath", "Listen", "What", "Where", "LoadState"])
+    objs = []
+    for n in sorted(names):
+        x = info.get(n) or {}
+        fp = (x.get("FragmentPath") or [""])[0]
+        objs.append(["SystemdUnit", n, n.rsplit(".", 1)[-1], os.path.dirname(fp) or None,
+                     ",".join(sorted(v.split(" (")[0] for v in x.get("Listen") or [] if v)) or None,
+                     ((x.get("What") or [""])[0] or None) if n.endswith(".mount") else None,
+                     ((x.get("Where") or [""])[0] or None) if n.endswith(".mount") else None])
+    return {"objects": objs, "edges": edges}
