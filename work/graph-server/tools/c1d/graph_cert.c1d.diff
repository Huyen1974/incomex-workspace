+def catalog_read(path=None):
+    """Đọc danh mục ô MỘT lần ⇒ (sha256 đúng byte đã đọc, đối tượng | None, lỗi | None). Không bao giờ ném lỗi."""
+    try:
+        with open(path or CELLS, "rb") as f:
+            b = f.read()
+    except OSError as e:
+        return None, None, "CATALOG_UNREADABLE %s" % type(e).__name__
+    h = hashlib.sha256(b).hexdigest()
+    try:
+        obj = json.loads(b.decode("utf-8"))
+    except (ValueError, UnicodeDecodeError):
+        return h, None, "CATALOG_MALFORMED"
+    if not isinstance(obj, dict) or obj.get("format") != "graph-cert-cells-v1" or not isinstance(obj.get("cells"), list):
+        return h, None, "CATALOG_MALFORMED"
+    return h, obj, None
+
+
+def cell_def_sha(c):
+    """Băm định nghĩa MỘT ô (khoá + phạm vi + nguồn + đặc tả Graph/loại cạnh + cha + lớp mở) — đổi bất kỳ phần nào dưới cùng khoá ⇒ khác."""
+    return hashlib.sha256(jkey(c).encode()).hexdigest()
+
+
+def catalog_fence(doc, cat_sha, cat_obj, cat_err):
+    """So danh mục SỐNG với danh mục giấy đã dùng ⇒ (status, why, {khoá ô: lý do}). status MATCH | CATALOG_CHANGED_SINCE_CERT |
+    CATALOG_VERSION_UNVERIFIED. Lý do từng ô áp cho ô đổi định nghĩa / thiếu băm định nghĩa (giấy trước K3)."""
+    want = (doc or {}).get("catalog_sha256")
+    if cat_err or not cat_obj or not cat_sha:
+        return "CATALOG_VERSION_UNVERIFIED", "danh mục sống không đọc được: %s" % (cat_err or "vắng"), {}
+    if not isinstance(want, str) or not RE_SHA.fullmatch(want):
+        return "CATALOG_VERSION_UNVERIFIED", "giấy không có catalog_sha256 hợp lệ", {}
+    if (doc or {}).get("engine_sha256") != _SELF_SHA or (doc or {}).get("engine_version") != ENGINE_VERSION:
+        return "CATALOG_VERSION_UNVERIFIED", "ENGINE_CHANGED_SINCE_CERT bộ máy cấp giấy %s/%s ≠ bộ máy đang nhãn %s/%s" % (
+            (doc or {}).get("engine_version"), str((doc or {}).get("engine_sha256"))[:12], ENGINE_VERSION, str(_SELF_SHA)[:12]), {}
+    if want != cat_sha:
+        return "CATALOG_CHANGED_SINCE_CERT", "danh mục ô đổi sau khi cấp giấy (giấy %s ≠ sống %s)" % (want[:12], cat_sha[:12]), {}
+    live = {c.get("key"): cell_def_sha(c) for c in cat_obj["cells"]}
+    per = {}
+    for k, c in ((doc or {}).get("cells") or {}).items():
+        d = c.get("cell_def_sha256")
+        if not d:
+            per[k] = "CATALOG_VERSION_UNVERIFIED ô cấp trước K3 (không có cell_def_sha256)"
+        elif live.get(k) != d:
+            per[k] = "CATALOG_CHANGED_SINCE_CERT định nghĩa ô đổi dưới cùng khoá" if k in live else "CATALOG_CHANGED_SINCE_CERT ô không còn trong danh mục"
+    return "MATCH", None, per
