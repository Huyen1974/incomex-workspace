+def l2_tick(rec):
+    """L2 làm mới MỖI lượt run (C1-D, chỉ đọc nguồn, ghi tệp trạng thái): c1b_l2.py ⇒ tệp tạm ⇒ thêm cờ nightly_refresh ⇒ băm lại ⇒ thay.
