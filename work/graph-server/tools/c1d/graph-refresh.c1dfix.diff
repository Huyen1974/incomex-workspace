+def rec_exchange(a, b):
+    """Tráo NGUYÊN TỬ hai thư mục cùng hệ tệp (renameat2 RENAME_EXCHANGE): không lúc nào thiếu `current`."""
+    libc = ctypes.CDLL(None, use_errno=True)
+    if libc.renameat2(-100, os.fsencode(a), -100, os.fsencode(b), 2) != 0:       # AT_FDCWD=-100 · RENAME_EXCHANGE=2
+        e = ctypes.get_errno()
+        raise OSError(e, "renameat2 RENAME_EXCHANGE " + os.strerror(e))
+
+
+def commit_recovery_point(stg, rp):
+    """Chốt D23 — bước CUỐI của lượt: bản tạm còn nguyên (verify_files) + recovery-manifest đang trỏ đúng meta của nó ⇒ tráo nguyên tử với
+    `current`. Trả đường đang giữ bản cũ (xoá được ngay) hoặc None khi trước đó chưa có `current`."""
+    meta, bad = GR.verify_files(stg)
+    cur = (jload(RECMAN) or {}).get("current") or {}
+    if bad or sha_file(stg + "/meta.json") != rp["meta_sha256"] or cur.get("meta_sha256") != rp["meta_sha256"] or meta["state"] != rp["state"]:
+        raise Fail("điểm khôi phục tạm không cùng thế hệ recovery-manifest %s" % bad)
+    if not os.path.isdir(REC_CUR):
+        os.rename(stg, REC_CUR)
+        return None
+    rec_exchange(stg, REC_CUR)
+    return stg
 
 
