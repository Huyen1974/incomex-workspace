+def code_admission(repo, phase, held=0, probe=None):
+    """GS-RAM-GATE: cổng nhận lane code (chỉ đọc /proc). cần = sàn + trần Cognee + trần Neo4j tạm + đệm − held (phần trần Neo4j tạm đã nằm
+    trong MemAvailable khi bản tạm đang chạy). Áp lực thật (PSI memory, swap vào/ra 1 s, đĩa) cũng chặn như T6; PSI không đọc được ⇒ chặn."""
+    m = (probe or _admit_measure)()
+    need = CODE_ADMIT_NEED_B - max(0, min(int(held or 0), TEMP_CAP_B))
+    psi = m.get("psi_mem")
+    why = [x for x, bad in (("RAM", m["mem_avail"] < need),
+                            ("PSI memory %s > %.1f" % ("?" if psi is None else "%.1f" % psi, T6_PSI_MEM_MAX), psi is None or psi > T6_PSI_MEM_MAX),
+                            ("swap %d trang/s > %d" % (m["swap_pages_1s"], T6_SWAP_PAGES_MAX), m["swap_pages_1s"] > T6_SWAP_PAGES_MAX),
+                            ("đĩa < 20GiB", m["disk_free"] < 20 * 1024 ** 3)) if bad]
+    gb = lambda b: b / 1024 ** 3
+    short = max(0, need - m["mem_avail"])
+    head = "; ".join(("RAM thiếu %.1fGiB (cần %.1f có %.1f)" % (gb(short), gb(need), gb(m["mem_avail"]))) if x == "RAM" else x for x in why)
+    return {"repo": repo, "phase": phase, "at": now(), "ok": not why, "why": why, "required": need, "available": m["mem_avail"], "shortfall": short,
+            "held": int(held or 0), "budget": {"floor": RAM_FLOOR_B, "cognee_cap": COG_CAP_B, "temp_cap": TEMP_CAP_B, "buffer": ADMIT_BUFFER_B},
+            "psi_mem": psi, "swap_pages_1s": m["swap_pages_1s"], "disk_free": m["disk_free"], "owner": RES_OWNER,
+            "digest": "code:%s thiếu %.1f/%.1fGiB" % (repo, gb(short), gb(need)) if "RAM" in why else "code:%s %s" % (repo, head[:40]),
+            "reason": "%s · RESOURCE_BLOCKED %s · sàn 3 + Cognee 1.5 + Neo4j tạm 1 + đệm 0.5 · không dựng container · ô MỘT PHẦN · NOT_ACTION_SAFE"
+                      % (head or "đủ", repo)}
+
+
+def admit_code(todo, report, probe=None):
+    """GS-RAM-GATE: bỏ có chủ các mục code:* ĐỨNG ĐẦU hàng chờ khi cổng nhận không đạt ⇒ (hàng chờ còn lại, [admission thiếu]). Gặp mục
+    không phải code hoặc code đã nhận thì dừng (vẫn MỘT mục/lượt); mục sau không bị đánh giá ở lượt này."""
+    todo, skipped = list(todo), []
+    while todo and todo[0].startswith("code:"):
+        adm = code_admission(todo[0].split(":", 1)[1], "select", probe=probe)
+        report.setdefault(todo[0], {})["admission"] = [adm]
+        if adm["ok"]:
+            break
+        skipped.append(adm)
+        todo.pop(0)
+    return todo, skipped
+
+
+def res_owned(rec):
+    """GS-RAM-GATE: SKIP_RESOURCE ⇒ vàng có chủ (graph_cert.alarm SOURCE_BLOCKED_OWNED), một mục/cây; lỗi nội bộ Graph vẫn ĐỎ riêng."""
+    seen, out = set(), []
+    for adm in rec.get("resource_skip") or []:
+        if adm["repo"] not in seen:
+            seen.add(adm["repo"])
+            out.append({"cell": "code:" + adm["repo"], "owner": adm["owner"], "reason": adm["reason"], "digest": adm["digest"]})
+    return out
+
