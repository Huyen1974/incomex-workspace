+def _admit_measure():
+    s0 = _vmswap()
+    time.sleep(1)
+    return {"mem_avail": mem_avail(), "psi_mem": _psi("memory"), "swap_pages_1s": _vmswap() - s0, "disk_free": shutil.disk_usage("/").free}
