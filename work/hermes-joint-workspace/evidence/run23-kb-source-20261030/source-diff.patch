+@pytest.mark.parametrize('client_name,names', [('stdio',['upload_document','update_document','patch_document','delete_document','ingest_document']),('hybrid',['upload_document','update_document','delete_document','ingest_document'])])
+def test_kb_actual_clients_forward_untrusted_header_and_receipt(client_name,names):
+    import ast,types,logging
+    sent=[];receipt={'authenticated_actor':'fixture:server','facts':{'origin_environment':{'provenance':'self_declared'}}}
+    class Client:
+        def __init__(self,*a,**kw):pass
+        async def __aenter__(self):return self
+        async def __aexit__(self,*a):pass
+        async def request(self,method,url,**kw):
+            sent.append((method,url,kw))
+            return KBObject(status_code=200,json=lambda:{'id':'knowledge/alpha','revision':2,'response':'accepted','declaration_receipt':receipt,'write_outcome':{'status':'handler_completed'}},text='fixture response')
+    class ConnectionFailure(Exception):pass
+    http=KBObject(AsyncClient=Client,ConnectError=ConnectionFailure,ConnectTimeout=ConnectionFailure,HTTPError=ConnectionFailure)
+    g={'kb_declaration':kb,'httpx':http,'os':__import__('os'),'logger':logging.getLogger('client-fixture'),'TextContent':KBObject,
+       '_get_auth_headers':lambda *a:{'X-API-Key':'fixture-only'},'_auth_headers':lambda *a:{'X-API-Key':'fixture-only'},
+       'AGENT_DATA_URL':'http://local.fixture','AGENT_DATA_URL_CLOUD':'http://cloud.fixture','_active_url':None,'_active_api_key':None}
+    async def ready(*a):return {'ready':True}
+    g['_ensure_remote_session_ready']=ready
+    selected={'_request_with_fallback','call_tool'} if client_name=='stdio' else {'_hybrid_request','execute_tool','upload_document','update_document','delete_document','ingest_document'}
+    path='mcp_server/stdio_server.py' if client_name=='stdio' else 'mcp_server/server.py'
+    tree=ast.parse((Path(__file__).resolve().parents[2]/path).read_text());nodes=[]
+    for node in tree.body:
+        if isinstance(node,ast.AsyncFunctionDef) and node.name in selected:
+            node.decorator_list=[x for x in node.decorator_list if not (isinstance(x,ast.Call) and isinstance(x.func,ast.Attribute) and isinstance(x.func.value,ast.Name) and x.func.value.id in ('app','server'))]
+            nodes.append(node)
+    exec(compile(ast.fix_missing_locations(ast.Module(body=ast.parse('from __future__ import annotations').body+nodes,type_ignores=[])),path,'exec'),g)
+    for name in names:
+        a=dict(args(),path='knowledge/alpha',content='new',old_str='old',new_str='new',source='inline')
+        if client_name=='stdio':out=asyncio.run(g['call_tool'](name,a))
+        else:
+            async def body():return a
+            out=asyncio.run(g['execute_tool'](name,KBObject(json=body)))
+        method,url,kw=sent[-1]
+        assert kb.parse(kw['headers'][kb.HEADER])==args()
+        assert kw['headers']['X-API-Key']=='fixture-only'
+        assert '/documents' in url or '/ingest' in url
+        if client_name=='stdio':assert json.loads(out[-1].text)['declaration_receipt']==receipt
+        else:assert out['result']['declaration_receipt']==receipt
+    assert kb.forwarding.get() is None
