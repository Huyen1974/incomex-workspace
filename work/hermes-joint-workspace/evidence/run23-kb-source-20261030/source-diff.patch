@@ -0,0 +1,186 @@
+"""Primary KB attribution, shared by authenticated MCP and REST writers.
+No credentials, storage, network, or authorization policy lives in this adapter.
+"""
+import contextvars
+import inspect
+import json
+from functools import wraps
+from agent_data import declaration_contract as d, hvu_signals
+
+PRIMARY = frozenset({'upload_document','update_document','patch_document','delete_document','ingest_document'})
+ADMIN_UNCOVERED = ('/kb/reindex','/kb/cleanup-orphans','/kb/reindex-missing','/kb/audit-sync')
+HEADER = 'X-Write-Declaration'
+MAX_HEADER = 8192
+identity = contextvars.ContextVar('kb_authenticated_context', default=None)
+incoming = contextvars.ContextVar('kb_write_input', default=None)
+forwarding = contextvars.ContextVar('kb_client_forwarding', default=None)
+effects = contextvars.ContextVar('kb_write_outcome', default=None)
+
+
+def fields(args):
+    if not isinstance(args, dict) or any(k.startswith('_') for k in args):
+        raise d.Denied('CLIENT_METADATA_FORBIDDEN', 'Supply only public declaration fields; private metadata is server-owned.')
+    return {k:args[k] for k in ('declared_actor','declaration_context') if k in args}
+
+
+def header(args):
+    value=fields(args)
+    if not value:return {}
+    raw=json.dumps(value,ensure_ascii=True,separators=(',',':'))
+    if len(raw.encode())>MAX_HEADER:raise d.Denied('DECLARATION_CONTEXT_INVALID','Declaration header exceeds 8192 bytes.')
+    return {HEADER:raw}
+
+
+def parse(raw):
+    if raw is None:return {}
+    if not isinstance(raw,str) or len(raw.encode())>MAX_HEADER:
+        raise d.Denied('DECLARATION_CONTEXT_INVALID','Use a JSON declaration header of at most 8192 bytes.')
+    try:value=json.loads(raw)
+    except (ValueError,TypeError):raise d.Denied('DECLARATION_CONTEXT_INVALID','Use JSON in X-Write-Declaration.')
+    fields(value)
+    if set(value)-{'declared_actor','declaration_context'}:
+        raise d.Denied('DECLARATION_CONTEXT_INVALID','Only declared_actor and declaration_context belong in this header.')
+    return value
+
+
+def profile_facts(profile, config):
+    """Only an already-authenticated profile ID selects operator-owned facts.
+    Labels, clientInfo, IP/host and shared keys are never product/origin mappings.
+    """
+    if not profile:return {}
+    raw=(config.get('master_profiles') or {}).get(profile['id'],{})
+    if (raw.get('enabled') is not True or raw.get('credential_env')!=profile.get('credential_env')
+            or raw.get('label')!=profile.get('label')):return {}
+    value=raw.get('declaration_facts',{})
+    if not isinstance(value,dict) or set(value)-set(d.EXAMPLES):
+        raise d.Denied('DECLARATION_CONTEXT_INVALID','Operator profile declaration_facts is invalid.')
+    return dict(value)
+
+
+def note(store,status):
+    value=effects.get()
+    if value is not None and status in ('error','skipped','unknown'):
+        value.append({'store':store,'status':status})
+
+
+def advertise(tools):
+    for tool in tools:
+        name=tool.get('name') if isinstance(tool,dict) else tool.name
+        if name not in PRIMARY:continue
+        schema=tool['inputSchema'] if isinstance(tool,dict) else tool.inputSchema
+        schema.setdefault('properties',{}).update(declared_actor=dict(d.FIELD),declaration_context=dict(d.CONTEXT_FIELD))
+    return tools
+
+
+def dispatch(func):
+    @wraps(func)
+    async def wrapped(tool_name,args,*a,**kw):
+        if tool_name not in PRIMARY:return await func(tool_name,args,*a,**kw)
+        try:
+            fields(args)
+            auth=identity.get() or {'who':hvu_signals.hidden(),'verified':{}}
+            if hvu_signals.agent_id() is not None:auth={'who':hvu_signals.hidden(),'verified':{}}
+            token=incoming.set(dict(auth,args=args))
+            try:return await func(tool_name,args,*a,**kw)
+            finally:incoming.reset(token)
+        except d.Denied as error:return error.result()
+    return wrapped
+
+
+def writer(*, response, encode, http_error, status_code=200):
+    """Wrap actual handlers, so MCP direct Python calls cannot bypass REST admission."""
+    def decorate(func):
+        signature=inspect.signature(func)
+        @wraps(func)
+        async def wrapped(*args,**kwargs):
+            bound=signature.bind_partial(*args,**kwargs).arguments
+            supplied=bound.get('_')
+            source=supplied if isinstance(supplied,dict) and 'who' in supplied else incoming.get()
+            source=source or {'who':None,'args':{},'verified':{}}
+            try:
+                public=dict(source['args']);fields(public)
+                # The handler target, not a caller's unrelated path, determines task scope.
+                target=bound.get('doc_id') or getattr(bound.get('payload'),'document_id',None)
+                if isinstance(target,str):public['path']=target
+                receipt=d.resolve(public,source['who'],verified=source.get('verified'))
+            except d.Denied as error:return response(status_code=403,content=error.result())
+            token=effects.set([])
+            try:
+                try:result=await func(*args,**kwargs)
+                except http_error as error:
+                    if receipt is None:raise
+                    return response(status_code=error.status_code,content={
+                        'error':'KB_WRITE_FAILED','detail':error.detail,'declaration_receipt':receipt,
+                        'write_outcome':{'status':'unconfirmed','atomic':False,'issues':effects.get()}})
+                if receipt is None:return result  # legacy response/model/semantics unchanged
+                content=encode(result)
+                content['declaration_receipt']=receipt
+                if effects.get():content['error']='KB_PARTIAL_WRITE'
+                content['write_outcome']={'status':'partial' if effects.get() else 'handler_completed',
+                                          'atomic':False,'issues':effects.get()}
+                return response(status_code=status_code,content=content)
+            finally:effects.reset(token)
+        return wrapped
+    return decorate
+
+
+def result(value):
+    """MCP dispatcher accepts both legacy models and declared HTTP responses."""
+    if hasattr(value,'body'):return json.loads(value.body)
+    return value.model_dump()
+
+
+def client_headers(method,path):
+    context=forwarding.get()
+    if context and method in ('POST','PUT','PATCH','DELETE') and (path=='/ingest' or path=='/documents' or path.startswith('/documents/')):
+        return header(context['args'])
+    return {}
+
+
+def capture(method,path,response):
+    context=forwarding.get()
+    if context is not None and method in ('POST','PUT','PATCH','DELETE') and (path=='/ingest' or path=='/documents' or path.startswith('/documents/')):
+        try:context['result']=response.json()
+        except ValueError:pass
+
+
+def client_call(*, text=None):
+    """Task-local transport metadata only; all facts remain untrusted until server admission."""
+    def decorate(func):
+        @wraps(func)
+        async def wrapped(name,arguments,*args,**kwargs):
+            if name not in PRIMARY:return await func(name,arguments,*args,**kwargs)
+            try:header(arguments)
+            except d.Denied as error:
+                return [text(type='text',text=json.dumps(error.result()))] if text else error.result()
+            context={'args':arguments};token=forwarding.set(context)
+            try:
+                out=await func(name,arguments,*args,**kwargs)
+                receipt=context.get('result',{}).get('declaration_receipt')
+                if text and receipt is not None:
+                    out.append(text(type='text',text=json.dumps({'declaration_receipt':receipt,'write_outcome':context['result'].get('write_outcome')})))
+                return out
+            finally:forwarding.reset(token)
+        return wrapped
+    return decorate
+
+
+def schemas(func):
+    @wraps(func)
+    async def wrapped(*a,**kw):return advertise(await func(*a,**kw))
+    return wrapped
+
+
+def client_request(func):
+    @wraps(func)
+    async def wrapped(tool_name,request):
+        if tool_name not in PRIMARY:return await func(tool_name,request)
+        try:
+            try:args=await request.json()
+            except ValueError:args={}
+            header(args)
+        except d.Denied as error:return {'result':error.result()}
+        token=forwarding.set({'args':args})
+        try:return await func(tool_name,request)
+        finally:forwarding.reset(token)
+    return wrapped
