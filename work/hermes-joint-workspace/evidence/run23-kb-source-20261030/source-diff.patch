+    if name=='upload_document':return g['create_document'](payload=KBObject(document_id='knowledge/new',parent_id='knowledge',content=KBObject(body='new',mime_type='text/plain'),metadata=KBObject(title='new',tags=[]),is_human_readable=True,created_at=None),**common)
+    if name=='update_document':return g[name](doc_id='knowledge/alpha',payload=KBObject(patch=KBObject(content=KBObject(body='new',mime_type='text/plain'),metadata=None,is_human_readable=None),update_mask=['content'],last_known_revision=1),**common)
+    if name=='patch_document':return g[name](doc_id='knowledge/alpha',payload=KBObject(old_str='old',new_str='new'),**common)
+    if name=='delete_document':return g[name](doc_id='knowledge/alpha',**common)
+    return g['ingest'](message=KBObject(text='inline',message=None,session_id=None),**common)
